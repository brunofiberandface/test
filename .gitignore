# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Service account keys
sa_key.json
sa_key_old.json
service-account*.json
*.key

# OAuth client secrets (e.g. client_secret.json from Google Cloud Console downloads)
client_secret*.json

# API keys
ANTHROPIC_KEY.md

# Claude session state (skill cache, tokens) — local to dev machine
.claude/

# Build leftovers preserved during recovery (not source-of-truth)
.next-old/

# Hand-edited backup copies kept during risky migrations
*.bak
*.bak.*
*-bak.*
Dockerfile.pre-matte-bak
src/lib/subject-matte.rembg-bak.ts

# One-off debug / smoke scripts — frequently created and discarded
tmp_*.mjs
tmp_*.ts
_tmp_debug_*.ts

# Editor / IDE
.vscode/
.idea/

# Python build artifacts (Cloud Run Job source has Python)
__pycache__/
*.pyc
